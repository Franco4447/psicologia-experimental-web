{
  "name": "web-experimento",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma web académica para experimento de Psicología Experimental - Universidad Favaloro",
  "scripts": {
    "dev": "node -e \"try { fs.rmSync('.next', { recursive: true, force: true }) } catch (e) {}\" && next dev",
    "build": "node -e \"try { fs.rmSync('.next', { recursive: true, force: true }) } catch (e) {}\" && next build",
    "start": "next start",
    "lint": "next lint",
    "copy-assets": "node scripts/copy-assets.js",
    "verify:m1": "tsx scripts/verify-milestone1.ts",
    "test": "node --experimental-strip-types tests/e2e/run_all_tests.ts",
    "test:unit": "node --experimental-strip-types tests/e2e/run_all_tests.ts",
    "test:e2e": "playwright test",
    "test:tier1": "node --experimental-strip-types tests/e2e/tier1_features.test.ts",
    "test:tier2": "node --experimental-strip-types tests/e2e/tier2_boundaries.test.ts",
    "test:tier3": "node --experimental-strip-types tests/e2e/tier3_combinations.test.ts",
    "test:tier4": "node --experimental-strip-types tests/e2e/tier4_simulations.test.ts",
    "test:m2": "tsx tests/m2_components_and_state.test.ts",
    "test:m3": "tsx tests/m3_sync_and_api.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.47.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "keywords": [
    "psychology",
    "experiment",
    "fake-news",
    "false-memories",
    "favaloro"
  ],
  "author": "Universidad Favaloro - Psicología Experimental",
  "license": "UNLICENSED"
}
