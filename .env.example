# Configuración de Entorno (.env.example)

# ==========================================
# Configuración de Supabase
# ==========================================
# Requerido: URL de la API de tu proyecto en Supabase.
# Para el proyecto actual, usa la URL generada (ej. https://incipxmbzxpzbgwinalp.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Requerido: Clave anónima pública de Supabase.
# Utilizada por el cliente para consultas a la base de datos respetando las políticas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Requerido (Solo Backend/Admin): Clave de servicio de Supabase con acceso total.
# NUNCA exponer esta clave en el lado del cliente (sin prefijo NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==========================================
# Configuración del Panel de Administración
# ==========================================
# Requerido: Contraseña para acceder a las rutas protegidas (/admin).
# En producción (Vercel), configurar con una contraseña segura.
ADMIN_PASSWORD=your-secure-admin-password

# ==========================================
# Configuración de Testing (Opcional)
# ==========================================
# Utilizado por Playwright para tests E2E locales y entornos de CI.
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
